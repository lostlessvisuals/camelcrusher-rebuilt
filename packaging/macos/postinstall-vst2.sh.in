#!/usr/bin/env bash
set -euo pipefail

ensure_symlink() {
  local target="$1"
  local link_path="$2"
  local backup_root="$3"

  mkdir -p "$(dirname "$link_path")"
  if [[ -L "$link_path" ]]; then
    [[ "$(readlink "$link_path")" == "$target" ]] && return 0
    rm -f "$link_path"
  elif [[ -e "$link_path" ]]; then
    # Move, never delete, an older real bundle out of the host's scan paths.
    mkdir -p "$backup_root"
    local backup_dir
    backup_dir="$(mktemp -d "$backup_root/vst2-upgrade.XXXXXX")"
    chmod 755 "$backup_dir"
    mv "$link_path" "$backup_dir/"
    echo "CamelCrusher: preserved previous bundle at $backup_dir" >&2
  fi
  ln -s "$target" "$link_path"
}

# Tests source only the helper and operate on disposable directories.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

canonical_bundle="/Library/Audio/Plug-Ins/VST/@CAMELCRUSHER_VST2_BUNDLE_NAME@.vst"
legacy_local_bundle="/Library/Audio/Plug-Ins/VST2/@CAMELCRUSHER_VST2_BUNDLE_NAME@.vst"
system_backups="/Library/Application Support/CamelCrusherRebuilt/Backups"
console_user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
console_home=""
if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  console_home="$(dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | sed 's/^NFSHomeDirectory: //')"
fi

if [[ -d "$canonical_bundle" ]]; then
  ensure_symlink "$canonical_bundle" "$legacy_local_bundle" "$system_backups"
  if [[ -n "$console_home" && -d "$console_home" ]]; then
    for format in VST VST2; do
      link="$console_home/Library/Audio/Plug-Ins/$format/@CAMELCRUSHER_VST2_BUNDLE_NAME@.vst"
      ensure_symlink "$canonical_bundle" "$link" "$console_home/Library/Application Support/CamelCrusherRebuilt/Backups"
      chown -h "$console_user":staff "$link"
    done
  fi
fi
exit 0
